{
  "name": "@osyte/fund-pacing",
  "version": "1.0.0",
  "description": "Takahashi-Alexander pacing model for private fund cash flows. Stateless, isomorphic, zero runtime dependencies.",
  "keywords": [
    "private-equity",
    "pacing",
    "cash-flow",
    "capital-call",
    "distribution",
    "nav",
    "takahashi-alexander",
    "private-markets",
    "forecasting"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osyte/fund-pacing.git"
  },
  "homepage": "https://github.com/osyte/fund-pacing#readme",
  "bugs": {
    "url": "https://github.com/osyte/fund-pacing/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema/index.d.ts",
        "default": "./dist/schema/index.js"
      },
      "require": {
        "types": "./dist/schema/index.d.cts",
        "default": "./dist/schema/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:package": "publint && attw --pack . --profile node16",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:package"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^4.3.0",
    "jsdom": "27.0.1",
    "publint": "^0.3.16",
    "tsdown": "^0.15.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "^4.1.13"
  }
}
